# Option 1 (Recommended): Kaggle API Token (KGAT_...)
# Or save raw token to ~/.kaggle/access_token
KAGGLE_API_TOKEN=KGAT_your_token_here

# Option 2: Legacy Kaggle Username + Key
# Or save {"username": "...", "key": "..."} to ~/.kaggle/kaggle.json
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_hex_key

